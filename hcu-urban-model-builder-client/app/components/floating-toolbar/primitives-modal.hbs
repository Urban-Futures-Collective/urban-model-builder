{{#unless @disabled}}
  <div class="node-dock__groups" role="toolbar" aria-label={{t "editor.add_node"}}>
    {{#each this.nodeGroups as |nodeGroup|}}
      <div class="node-dock__group">
        <span class="node-dock__label">
          {{t (concat "editor.dock_groups." nodeGroup.name)}}
        </span>
        {{#each nodeGroup.nodeTypes as |nodeType|}}
          <FloatingToolbar::Node
            @config={{this.getNodeTypeConfig nodeType}}
            @onClick={{this.onNodeClick}}
          />
        {{/each}}
      </div>
    {{/each}}
  </div>
{{/unless}}