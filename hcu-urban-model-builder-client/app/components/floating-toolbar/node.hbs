<button
  type="button"
  class="node-dock__item node-dock__item--{{@config.className}}"
  title={{t
    "editor.add_node_of_type"
    type=(t (concat "editor.node_types." @config.className))
  }}
  {{on "click" (fn @onClick @config)}}
>
  <span class="node-dock__swatch" aria-hidden="true"></span>
  <span class="node-dock__name">{{t
      (concat "editor.node_types." @config.className)
    }}</span>
</button>