{{page-title (t "routes.models.index.title")}}

<div class="library">
  <ModelsIndexHeader
    @title={{t "routes.models.title"}}
    @total={{this.total}}
    @canCreate={{true}}
    @hasSearchQuery={{this.hasSearchQuery}}
    @searchQuery={{this._q}}
    @clearSearch={{this.clearSearch}}
    @onSearchInput={{this.onSearchInput}}
    @onSearchChange={{this.onSearchChange}}
    @sort_key={{this.sort_key}}
    @sort_direction={{this.sort_direction}}
    @onSortChange={{this.onSortChange}}
    @startCreating={{this.startCreating}}
    @view={{this.view}}
    @onViewChange={{this.onViewChange}}
  />

  <ModelsIndexList
    @persistedModels={{this.persistedModels}}
    @user={{this.user}}
    @intl={{this.intl}}
    @view={{this.view}}
    @showNewTile={{not this.hasSearchQuery}}
    @featureFirst={{this.featureFirst}}
    @startCreating={{this.startCreating}}
    @startEditing={{this.startEditing}}
    @startDeleting={{this.startDeleting}}
    @hideOtherUsers={{true}}
  />

  <footer class="library__footer">
    <Ui::Pagination
      @model={{this.persistedModels}}
      @limit={{this.limit}}
      @total={{this.model.meta.total}}
      @page={{this.page}}
      @onPageChanged={{this.onPageChanged}}
      @onLimitChanged={{this.onLimitChanged}}
    />
  </footer>
</div>

<Model::FormModal
  @isOpen={{this.isModalOpen}}
  @mode={{this.mode}}
  @changeset={{this.changeset}}
  @onClose={{this.closeModal}}
  @onSubmit={{this.submitModel}}
/>
