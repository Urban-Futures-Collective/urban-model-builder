{{page-title (t "routes.index.title")}}

<div class="landing">
  <header class="landing__bar">
    <LinkTo @route="index" class="landing__brand">
      <img src="/assets/images/umb-mark.svg" alt="" width="28" height="28" />
      {{t "general.brand"}}
    </LinkTo>
    <nav class="landing__nav" aria-label={{t "shell.rail_label"}}>
      <a
        href="https://citysciencelab.github.io/urban-model-builder/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost btn-sm"
      >
        {{t "shell.docs"}}
      </a>
      <LinkTo @route="demo" class="btn btn-ghost btn-sm">
        {{t "general.demo"}}
      </LinkTo>
      <LinkTo @route="models" class="btn btn-primary btn-sm">
        {{t "landingpage.get_started"}}
      </LinkTo>
    </nav>
  </header>

  <section class="landing__hero">
    <img
      class="landing__mark"
      src="/assets/images/umb-mark-white.svg"
      alt=""
      aria-hidden="true"
    />
    <div class="landing__hero-inner">
      <span class="umb-eyebrow landing__eyebrow">
        {{t "landingpage.eyebrow"}}
      </span>
      <h1 class="landing__title">{{t "landingpage.title"}}</h1>
      <p class="landing__lead">{{t "landingpage.description"}}</p>
      <p class="landing__lead">{{t "landingpage.subtitle"}}</p>
      <div class="landing__actions">
        <LinkTo @route="models" class="btn btn-primary btn-lg">
          {{t "landingpage.get_started"}}
        </LinkTo>
        <LinkTo @route="demo" class="btn btn-secondary btn-lg">
          {{t "landingpage.demo"}}
        </LinkTo>
        <a
          href="https://citysciencelab.github.io/urban-model-builder/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary btn-lg"
        >
          {{t "landingpage.learn_more"}}
        </a>
      </div>
    </div>
  </section>

  <section class="landing__section">
    <div class="landing__grid">
      <div>
        <video class="landing__video" autoplay muted loop playsinline>
          <source
            src="/assets/videos/720p_modelbuilder_2.mp4"
            type="video/mp4"
          />
          {{t "landingpage.video_not_supported"}}
        </video>
        {{! template-lint-disable no-triple-curlies }}
        <p class="landing__credits">{{{t "landingpage.video_credits"}}}</p>
      </div>
      <div class="landing__feature">
        <h2 class="h3">{{t "landingpage.feature1.title"}}</h2>
        <p>{{t "landingpage.feature1.description"}}</p>
      </div>
    </div>
  </section>

  <section class="landing__section">
    <div class="landing__grid">
      <div class="landing__feature">
        <h2 class="h3">{{t "landingpage.feature2.title"}}</h2>
        <p>{{t "landingpage.feature2.description"}}</p>
      </div>
      <video class="landing__video" controls autoplay loop muted playsinline>
        <source src="/assets/videos/SD.mp4" type="video/mp4" />
        {{t "landingpage.video_not_supported"}}
      </video>
      <video class="landing__video" controls autoplay muted playsinline>
        <source src="/assets/videos/ABM.mp4" type="video/mp4" />
        {{t "landingpage.video_not_supported"}}
      </video>
    </div>
  </section>

  <section class="landing__section">
    <div class="landing__grid">
      <video class="landing__video" controls autoplay loop muted playsinline>
        <source src="/assets/videos/API Features.mp4" type="video/mp4" />
        {{t "landingpage.video_not_supported"}}
      </video>
      <div class="landing__feature">
        <h2 class="h3">{{t "landingpage.feature3.title"}}</h2>
        <p>{{t "landingpage.feature3.description"}}</p>
      </div>
    </div>
  </section>

  <section class="landing__section landing__section--grey">
    <div>
      <h2 class="landing__section-title">{{t "landingpage.comodeling"}}</h2>
      <p class="landing__prose">{{t "landingpage.comodeling_description"}}</p>
      <iframe
        class="landing__embed"
        src="https://www.youtube.com/embed/p3ftnO9M6CE?si=VzJVycmyUuTgGxkA"
        title={{t "landingpage.video_title"}}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
      <div class="landing__actions mt-4">
        <LinkTo @route="models" class="btn btn-primary btn-lg">
          {{t "landingpage.get_started"}}
        </LinkTo>
        <LinkTo @route="demo" class="btn btn-secondary btn-lg">
          {{t "landingpage.demo"}}
        </LinkTo>
      </div>
    </div>
  </section>

  <section class="landing__section">
    <h2 class="landing__section-title">{{t "landingpage.oss"}}</h2>
    {{! template-lint-disable no-triple-curlies }}
    <p class="landing__prose">{{{t "landingpage.oss_description"}}}</p>
  </section>

  <footer class="landing__footer">
    <div class="landing__footer-grid">
      <div class="d-flex flex-column gap-3">
        <img
          class="landing__ufc-logo"
          src="/assets/images/ufc-logo-white.svg"
          alt={{t "landingpage.footer.ufc_name"}}
        />
        <p class="mb-0">{{t "landingpage.footer.ufc_text"}}</p>
      </div>

      <div>
        <h2>{{t "landingpage.footer.links_title"}}</h2>
        <ul>
          <li>
            <LinkTo @route="datenschutz">{{t
                "landingpage.footer.link_privacy"
              }}</LinkTo>
          </li>
          <li>
            <LinkTo @route="impressum">{{t
                "landingpage.footer.link_imprint"
              }}</LinkTo>
          </li>
          <li>
            <LinkTo @route="nutzungsbedingungen">{{t
                "landingpage.footer.link_terms"
              }}</LinkTo>
          </li>
          <li>
            <a
              href="https://connectedurbantwins.de"
              target="_blank"
              rel="noopener noreferrer"
            >{{t "landingpage.footer.cut"}}</a>
          </li>
          <li>
            <a
              href="https://citysciencelab.hamburg"
              target="_blank"
              rel="noopener noreferrer"
            >{{t "landingpage.footer.csl"}}</a>
          </li>
        </ul>
      </div>

      <div class="d-flex flex-column gap-3">
        <h2 class="mb-0">{{t "landingpage.footer.about_title"}}</h2>
        <div class="landing__footer-logos">
          <img
            src="/assets/images/CUT_Logo_white.svg"
            alt={{t "landingpage.footer.cut"}}
          />
          <img
            src="/assets/images/CSL_Logo_weis.png"
            alt={{t "landingpage.footer.csl"}}
          />
        </div>
      </div>

      <div class="d-flex flex-column gap-3">
        <h2 class="mb-0">{{t "landingpage.footer.funded_by"}}</h2>
        <div class="landing__funders">
          <img
            src="/assets/images/CUT_Funders.svg"
            alt={{t "landingpage.footer.funded_by"}}
          />
        </div>
      </div>
    </div>
  </footer>
</div>