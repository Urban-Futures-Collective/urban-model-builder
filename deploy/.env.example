# Urban Model Builder – deployment settings
# Dokploy: paste these into the compose service's "Environment" tab.
# Plain Docker: copy to deploy/.env and run `docker compose up -d` in deploy/.

# Public address of the tool (the domain routed to the frontend service)
UMB_PUBLIC_URL=https://modelbuilder.example.org

# Optional: a separate public address for the backend. Leave empty to use
# UMB_PUBLIC_URL (the frontend proxies the backend on the same domain).
UMB_API_URL=

# Your existing Keycloak (not part of this stack)
UMB_KEYCLOAK_URL=https://auth.example.org
UMB_KEYCLOAK_REALM=urban-model-builder
UMB_KEYCLOAK_CLIENT_ID=urban-model-builder
# Audience the backend requires in access tokens. Recommended: add an
# "Audience" mapper for the client in Keycloak and set this to the client ID.
# "account" works with Keycloak's defaults for users that have the realm's
# default roles.
UMB_KEYCLOAK_AUDIENCE=urban-model-builder

# Database
POSTGRES_USER=umb
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=urban_model_builder

# Secret for the backend's own tokens (any long random string),
# e.g. `openssl rand -base64 32`
FEATHERS_SECRET=change-me-long-random

# Optional: bcrypt hash of the admin token for the admin/* endpoints
# (approving models for the Urban Model Platform). Create it with
# `npm run hash-password <token>` in the repo root. Keep the single quotes:
# the hash contains `$` characters.
ADMIN_TOKEN_HASH=''
